<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin xyz="-0.04 0 0.1825" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo-generated lidar frame -->
    <link name="mybot_2wd/base_link/laser"/>

    <joint name="gazebo_laser_tf_joint" type="fixed">
    <parent link="laser_frame"/>
    <child link="mybot_2wd/base_link/laser"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <material name="red"><color rgba="1.0 0 0 1.0"/></material>
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>



    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="gpu_lidar">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ignition_frame_id>laser_frame</ignition_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
            <topic>scan</topic>
            <!-- <frame_id>laser_frame</frame_id> -->
        </sensor>
    </gazebo>

</robot>