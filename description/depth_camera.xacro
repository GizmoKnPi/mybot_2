<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= CAMERA MOUNT ================= -->

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.27" rpy="0 0.11 0"/>
  </joint>

  <!-- ================= MIRRORED FRAME (HACK) ================= -->

  <link name="mybot_2wd/base_link/camera_depth"/>

  <joint name="gazebo_camera_depth_tf_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="mybot_2wd/base_link/camera_depth"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= CAMERA LINKS ================= -->

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.07 0.035"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ================= GAZEBO DEPTH SENSOR ================= -->

  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>

    <sensor name="depth_camera" type="depth">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>

      <!-- Depth image -->
      <topic>camera/depth/image_raw</topic>

      <!-- Force Gazebo frame -->
      <gz_frame_id>camera_link_optical</gz_frame_id>

      <!-- Point cloud -->
      <point_cloud>
        <topic>camera/depth/points</topic>
        <frame_id>mybot_2wd/base_link/camera_depth</frame_id>
      </point_cloud>

    </sensor>
  </gazebo>

</robot>
